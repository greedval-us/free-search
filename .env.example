APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
SEO_DEFAULT_IMAGE=/social-preview.png

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SECURITY_HEADERS_ENABLED=false
SECURITY_HSTS_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_CSP_EXCLUDED_PATHS=admin,admin/*
SECURITY_REGISTRATION_PER_MINUTE=5
SECURITY_REGISTRATION_PER_HOUR=20
SECURITY_PASSWORD_RESET_PER_MINUTE=5
SECURITY_PASSWORD_RESET_PER_HOUR=20
SECURITY_PASSWORD_RESET_PER_EMAIL_PER_MINUTE=3
SECURITY_RESEND_WEBHOOK_PER_MINUTE=60
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=150
DB_QUEUE_RETRY_AFTER=150
BEANSTALKD_QUEUE_RETRY_AFTER=150
REPORT_SNAPSHOT_TTL_SECONDS=3600

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
PARSER_RUN_RETENTION_DAYS=7
PARSER_RUN_CLEANUP_BATCH_SIZE=500
PARSER_RUN_CLEANUP_SCHEDULE=03:30
PARSER_RUN_HISTORY_LIMIT=20
PARSER_RUN_QUEUE_ENABLED=true
PARSER_RUN_QUEUE_NAME=default
PARSER_RUN_QUEUE_STEP_DELAY_SECONDS=2
ACTIVITY_LOG_RETENTION_DAYS=90
ACTIVITY_LOG_CLEANUP_SCHEDULE=04:00

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =========================
# OSINT: FIO (поиск по ФИО)
# =========================
# User-Agent для внешних запросов модуля FIO.
OSINT_FIO_HTTP_USER_AGENT="FreeSearch-FIO/1.0"
# Таймаут HTTP-запроса (секунды).
OSINT_FIO_HTTP_TIMEOUT=12
# Количество повторов при ошибках.
OSINT_FIO_HTTP_RETRY_ATTEMPTS=1
# Пауза между повторами (миллисекунды).
OSINT_FIO_HTTP_RETRY_SLEEP=250

# ==============================
# OSINT: SiteIntel (сайт и WHOIS)
# ==============================
# User-Agent для проверок сайта.
OSINT_SITE_HEALTH_HTTP_USER_AGENT="FreeSearch-SiteHealth/1.0"
# Заголовок Accept для HTTP-проверок.
OSINT_SITE_HEALTH_HTTP_ACCEPT="*/*"
# Таймаут HTTP-запроса (секунды).
OSINT_SITE_HEALTH_HTTP_TIMEOUT=10
# Максимум редиректов при обходе.
OSINT_SITE_HEALTH_HTTP_MAX_REDIRECTS=5
# Проверять SSL-сертификат (true/false).
OSINT_SITE_HEALTH_HTTP_VERIFY_SSL=true
# WHOIS IANA-сервер для определения целевого WHOIS.
OSINT_SITE_INTEL_WHOIS_IANA_SERVER=whois.iana.org
# Таймаут подключения WHOIS (секунды).
OSINT_SITE_INTEL_WHOIS_CONNECT_TIMEOUT=8
# Таймаут чтения WHOIS-ответа (секунды).
OSINT_SITE_INTEL_WHOIS_READ_TIMEOUT=8
# Размер чанка чтения WHOIS (байт).
OSINT_SITE_INTEL_WHOIS_READ_CHUNK_SIZE=2048
# Максимальный размер WHOIS-ответа (байт).
OSINT_SITE_INTEL_WHOIS_MAX_RESPONSE_BYTES=120000

# ============================
# OSINT: Username (проверка юзнеймов)
# ============================
# Таймаут подключения к источнику (секунды).
OSINT_USERNAME_HTTP_CONNECT_TIMEOUT=6
# Общий таймаут запроса (секунды).
OSINT_USERNAME_HTTP_TIMEOUT=8
# Максимум редиректов.
OSINT_USERNAME_HTTP_MAX_REDIRECTS=5
# User-Agent для проверки профилей.
OSINT_USERNAME_HTTP_USER_AGENT="Mozilla/5.0 (compatible; UraborosOSINT/1.0; +https://localhost)"
# Заголовок Accept.
OSINT_USERNAME_HTTP_ACCEPT="text/html,application/xhtml+xml"

# ==================================
# OSINT: Telegram аналитика и лимиты
# ==================================
# Минимальный период аналитики (дней).
OSINT_TELEGRAM_ANALYTICS_PERIOD_MIN_DAYS=1
# Максимальный период аналитики (дней).
OSINT_TELEGRAM_ANALYTICS_PERIOD_MAX_DAYS=7
# Максимум дней для custom range.
OSINT_TELEGRAM_ANALYTICS_CUSTOM_RANGE_MAX_DAYS=7
# TTL кэша summary (секунды).
OSINT_TELEGRAM_ANALYTICS_SUMMARY_CACHE_TTL=60
# До какого диапазона строим группировку по часам.
OSINT_TELEGRAM_ANALYTICS_GROUP_BY_HOUR_THRESHOLD_HOURS=36
# Лимит топ-постов в summary.
OSINT_TELEGRAM_ANALYTICS_TOP_POSTS_LIMIT=5
# Лимит элементов в распределениях.
OSINT_TELEGRAM_ANALYTICS_TOP_DISTRIBUTION_LIMIT=5
# Лимиты пагинации при сборе данных.
OSINT_TELEGRAM_ANALYTICS_FETCH_MAX_PAGES=20
OSINT_TELEGRAM_ANALYTICS_FETCH_PAGE_LIMIT=100
# Ограничения для аудитории.
OSINT_TELEGRAM_ANALYTICS_AUDIENCE_TOP_AUTHORS_SHARE_LIMIT=5
OSINT_TELEGRAM_ANALYTICS_AUDIENCE_MOST_ACTIVE_HOURS_LIMIT=3
OSINT_TELEGRAM_ANALYTICS_AUDIENCE_HOUR_MIN=0
OSINT_TELEGRAM_ANALYTICS_AUDIENCE_HOUR_MAX=23
# Параметры антифрода.
OSINT_TELEGRAM_ANALYTICS_FRAUD_SUSPICIOUS_POST_EXCERPT_LENGTH=160
OSINT_TELEGRAM_ANALYTICS_FRAUD_SUSPICIOUS_POSTS_LIMIT=5
OSINT_TELEGRAM_ANALYTICS_FRAUD_RISK_MAX_SCORE=100
OSINT_TELEGRAM_ANALYTICS_FRAUD_RISK_MEDIUM_THRESHOLD=30
OSINT_TELEGRAM_ANALYTICS_FRAUD_RISK_HIGH_THRESHOLD=60
# Базовые лимиты выдачи Telegram-поиска/комментариев.
OSINT_TELEGRAM_MESSAGES_LIMIT_DEFAULT=20
OSINT_TELEGRAM_MESSAGES_LIMIT_MAX=100
OSINT_TELEGRAM_COMMENTS_LIMIT_DEFAULT=20
OSINT_TELEGRAM_COMMENTS_LIMIT_MAX=50
# Максимум дней для кастомного диапазона парсера.
OSINT_TELEGRAM_PARSER_CUSTOM_RANGE_MAX_DAYS=31

# ======================================
# OSINT: NewsMediaIntel (SearXNG)
# ======================================
# Local instance: docker/searxng/Start.ps1. JSON output must be enabled.
OSINT_NEWS_MEDIA_SEARXNG_BASE_URL=http://127.0.0.1:8088
OSINT_NEWS_MEDIA_SEARXNG_LANGUAGE=ru
# Leave empty to use all configured news engines.
OSINT_NEWS_MEDIA_SEARXNG_ENGINES=
OSINT_NEWS_MEDIA_MAX_MENTIONS=120
OSINT_NEWS_MEDIA_SEARXNG_MAX_PAGES=3
OSINT_NEWS_MEDIA_SEARXNG_TIMEOUT=10
OSINT_NEWS_MEDIA_SEARXNG_REQUEST_BUDGET=20
OSINT_NEWS_MEDIA_SEARXNG_SAFESEARCH=1
# Optional: day, month, year. Engines may not support this filter.
OSINT_NEWS_MEDIA_SEARXNG_TIME_RANGE=

# =========================
# YouTube Data API v3
# =========================
YOUTUBE_DATA_API_KEY=
YOUTUBE_DATA_API_BASE_URL=https://www.googleapis.com/youtube/v3
# Bluesky application credentials, reused by Search/Analytics/Parser/Monitoring.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social
# Mastodon requests always use this operator-configured instance; a token is required.
MASTODON_API_TOKEN=
MASTODON_API_BASE_URL=https://mastodon.social

# =========================
# Frontend
# =========================
VITE_APP_NAME="${APP_NAME}"

# =========================
# MoonShine Admin (Production baseline)
# =========================
# Example:
# MOONSHINE_ROUTE_PREFIX=control-room
# MOONSHINE_TITLE="Uraboros Control"
# MOONSHINE_DOMAIN=admin.example.com
# MOONSHINE_ENFORCE_IP_ALLOWLIST=true
# MOONSHINE_ALLOWED_IPS=203.0.113.10,198.51.100.7
# MOONSHINE_LOGIN_MAX_ATTEMPTS=3
# MOONSHINE_LOGIN_DECAY_SECONDS=60
# MOONSHINE_LOGIN_ALERT_CHANNEL=stack
# MOONSHINE_LOGIN_ALERT_EMAIL_ENABLED=true
# MOONSHINE_LOGIN_ALERT_EMAIL=security@example.com

# =========================
# Production checklist (set on server)
# =========================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://example.com
# SESSION_SECURE_COOKIE=true

# =========================
# Telegram API (MadelineProto)
# =========================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Dedicated background worker required; never use the sync connection.
TELEGRAM_TRACKING_QUEUE_CONNECTION=database
TELEGRAM_TRACKING_QUEUE=telegram-tracking
TELEGRAM_TRACKING_INTERVAL_HOURS=6
# Recheck this much of the previous search window; duplicate messages are ignored.
TELEGRAM_TRACKING_SEARCH_OVERLAP_SECONDS=300

# Optional website bot, separate from MadelineProto. Create its token on the VPS.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAPH_WEBHOOK_SECRET=
# Defaults to QUEUE_CONNECTION and the default queue listened to by existing workers.
TELEGRAM_BOT_QUEUE=default
TELEGRAM_BOT_LINK_TTL_SECONDS=600
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
BILLING_CHECKOUT_ENABLED=false

# Daily feature limits. Resource-specific overrides are also supported, for example:
# ACCESS_FREE_TELEGRAM_PARSER_DAILY_LIMIT=2
ACCESS_FREE_ANALYTICS_DAILY_LIMIT=1
ACCESS_FREE_PARSER_DAILY_LIMIT=1
ACCESS_FREE_SEO_AUDIT_DAILY_LIMIT=1
ACCESS_PLUS_ANALYTICS_DAILY_LIMIT=10
ACCESS_PLUS_PARSER_DAILY_LIMIT=5
ACCESS_PLUS_SEO_AUDIT_DAILY_LIMIT=10
ACCESS_PRO_ANALYTICS_DAILY_LIMIT=100
ACCESS_PRO_PARSER_DAILY_LIMIT=50
ACCESS_PRO_SEO_AUDIT_DAILY_LIMIT=100

# =========================
# Monitoring projects and immutable reports
# =========================
# Run a dedicated durable queue worker and Laravel scheduler every minute.
# Guide: docs/modules/monitoring.md (RU), docs/modules/monitoring.en.md (EN).
MONITORING_QUEUE_CONNECTION=database
MONITORING_QUEUE=monitoring
# Default for newly created projects; each project/schedule stores its own timezone.
MONITORING_TIMEZONE=Europe/Moscow
# First collection starts at the UTC day boundary this many days ago (0..31).
MONITORING_INITIAL_LOOKBACK_DAYS=7
# Wait for collection coverage before finishing a report as partial.
MONITORING_REPORT_WAIT_SECONDS=300
# 1: latest missed schedule occurrence only; 0: skip accumulated backlog.
MONITORING_CATCH_UP_REPORTS=1

# Development defaults, not approved commercial plan entitlements.
# Reports use a separate feature quota; background collection never spends Parser quota.
MONITORING_FREE_ACTIVE_PROJECTS=1
MONITORING_FREE_SAVED_PROJECTS=5
MONITORING_FREE_SOURCES=3
MONITORING_FREE_MIN_INTERVAL_MINUTES=360
ACCESS_FREE_MONITORING_REPORT_DAILY_LIMIT=2
MONITORING_FREE_ITEMS_DAILY=1000
MONITORING_FREE_RETENTION_DAYS=90

MONITORING_PLUS_ACTIVE_PROJECTS=3
MONITORING_PLUS_SAVED_PROJECTS=10
MONITORING_PLUS_SOURCES=10
MONITORING_PLUS_MIN_INTERVAL_MINUTES=180
ACCESS_PLUS_MONITORING_REPORT_DAILY_LIMIT=10
MONITORING_PLUS_ITEMS_DAILY=10000
MONITORING_PLUS_RETENTION_DAYS=180

MONITORING_PRO_ACTIVE_PROJECTS=5
MONITORING_PRO_SAVED_PROJECTS=20
MONITORING_PRO_SOURCES=20
MONITORING_PRO_MIN_INTERVAL_MINUTES=60
ACCESS_PRO_MONITORING_REPORT_DAILY_LIMIT=30
MONITORING_PRO_ITEMS_DAILY=30000
MONITORING_PRO_RETENTION_DAYS=365
